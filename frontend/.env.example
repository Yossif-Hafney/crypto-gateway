# PostgreSQL Database Connection
# Option 1: Use connection string (recommended for cloud services like Neon, Supabase, Railway)
DATABASE_URL=postgresql://username:password@localhost:5432/crypto_gateway

# Option 2: Individual settings (uncomment and update contactDb.ts if you prefer this)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=crypto_gateway
# DB_USER=postgres
# DB_PASSWORD=your_password

# Socket.IO Server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key
